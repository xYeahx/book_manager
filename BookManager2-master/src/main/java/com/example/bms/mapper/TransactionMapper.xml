<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bms.mapper.TransactionMapper">
  <resultMap id="BaseResultMap" type="com.example.bms.model.Transaction">
    <id column="transactionId" jdbcType="INTEGER" property="transactionId" />
    <result column="userId" jdbcType="INTEGER" property="userId" />
    <result column="type" jdbcType="VARCHAR" property="type" />
    <result column="amount" jdbcType="DECIMAL" property="amount" />
    <result column="description" jdbcType="VARCHAR" property="description" />
    <result column="createTime" jdbcType="TIMESTAMP" property="createTime" />
  </resultMap>
  <sql id="Base_Column_List">
    transactionId, userId, type, amount, description, createTime
  </sql>
  <insert id="insert" parameterType="com.example.bms.model.Transaction" useGeneratedKeys="true" keyProperty="transactionId">
    insert into `transaction` (userId, type, amount, description, createTime)
    values (#{userId,jdbcType=INTEGER}, #{type,jdbcType=VARCHAR},
            #{amount,jdbcType=DECIMAL}, #{description,jdbcType=VARCHAR},
            #{createTime,jdbcType=TIMESTAMP})
  </insert>
  <select id="selectByUserId" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" />
    from `transaction`
    where userId = #{userid,jdbcType=INTEGER}
    order by createTime desc
  </select>
</mapper>
